# TENK Legal MCP — Fly.io (Volume-backed DB) build.
# A DB NEM kerül az image-be: runtime-ban a Fly Volume adja (/app/data).

# ── Stage 1: Build ─────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
COPY api ./api
RUN npm run build

# ── Stage 2: Production ────────────────────────────────────────
FROM node:20-alpine AS production
WORKDIR /app

# ── Supercronic (linux-amd64, v0.2.46) ────────────────────────
# Forrás: https://github.com/aptible/supercronic/releases/tag/v0.2.46
# SHA-256 a linux-amd64 binárishoz (2026-06-05 ellenőrizve):
ARG SUPERCRONIC_URL=https://github.com/aptible/supercronic/releases/download/v0.2.46/supercronic-linux-amd64
ARG SUPERCRONIC_SHA256=5adff01c5a797663948e656d2b61d10932369ee437eb5cb54fa872b2960f222b
RUN apk add --no-cache curl \
    && curl -fsSL "$SUPERCRONIC_URL" -o /usr/local/bin/supercronic \
    && echo "${SUPERCRONIC_SHA256}  /usr/local/bin/supercronic" | sha256sum -c - \
    && chmod +x /usr/local/bin/supercronic \
    && apk del curl

COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts
# better-sqlite3 natív C++ addon — a builder stage-ben már le van fordítva
# (python3/make/g++ ott rendelkezésre állt). Átmásoljuk az előre lefordított
# binárist; így a production image-ben NEM kell build-toolchain.
COPY --from=builder /app/node_modules/better-sqlite3 ./node_modules/better-sqlite3
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/scripts ./scripts

# Entrypoint, cron-wrapper és crontab másolása
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
COPY crontab /app/crontab

# cron-run.sh a scripts/-ben van (fentebb már COPY-zva),
# de itt biztosítjuk a futtatható jogot
RUN chmod +x /app/docker-entrypoint.sh /app/scripts/cron-run.sh

# A data/ mappát NEM másoljuk — a Volume mountolja ide.
RUN addgroup -S nodejs && adduser -S nodejs -G nodejs \
    && mkdir -p /app/data \
    && chown -R nodejs:nodejs /app/data /tmp

USER nodejs
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["/app/docker-entrypoint.sh"]
