# TENK Legal MCP — Fly.io (Volume-backed DB) build.
# A DB NEM kerül az image-be: runtime-ban a Fly Volume adja (/app/data).

# ── Stage 1: Build ─────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
COPY api ./api
RUN npm run build

# ── Stage 2: Production ────────────────────────────────────────
FROM node:20-alpine AS production
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/scripts ./scripts

# A data/ mappát NEM másoljuk — a Volume mountolja ide.
RUN addgroup -S nodejs && adduser -S nodejs -G nodejs \
    && mkdir -p /app/data \
    && chown -R nodejs:nodejs /app/data

USER nodejs
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["node", "dist/src/http-server.js"]
